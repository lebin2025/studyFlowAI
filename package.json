{
  "name": "studyflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "StudyFlow AI — AI-powered personalised study planning and task management platform.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "test": "npm run test:server && npm run test:unit -- --run",
    "test:server": "vitest run --config vitest.server.config.js",
    "test:unit": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:ai": "node scripts/verify-deepseek.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^9.2.5",
    "jsdom": "^30.0.1",
    "supertest": "^7.3.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

# ---------------------------------------------------------------------------
# StudyFlow AI — example environment file
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env        (macOS / Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
# Never commit `.env` — it is ignored by git.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development
# Alwaysdata injects PORT and IP automatically; its process env overrides this.
PORT=8787
# Used for "today", streaks and date buckets. Defaults to Asia/Shanghai.
APP_TIMEZONE=Asia/Shanghai

# Database ------------------------------------------------------------------
# Local development defaults to SQLite when DATABASE_URL is empty.
# In production set DATABASE_URL to a PostgreSQL / Supabase connection string.
# Supabase: use the Session Pooler URI (IPv4-compatible, works on Render).
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase requires TLS. Set false only for a local PostgreSQL without TLS.
DATABASE_SSL=true
DB_POOL_MAX=5
# SQLite fallback (ignored when DATABASE_URL is set).
# Relative paths are resolved from the project root.
DB_PATH=./server/data/studyflow.db

# Authentication ------------------------------------------------------------
# REQUIRED in production. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=sf_session
# Set to true when the site is served over HTTPS (required in production).
COOKIE_SECURE=false

# CORS / origin -------------------------------------------------------------
# The browser origin allowed to call the API with credentials.
# In development Vite proxies /api to this server, so same-origin is used.
APP_ORIGIN=http://localhost:5173
# Set to 1 only when running behind a trusted reverse proxy (nginx, Render...).
TRUST_PROXY=0

# DeepSeek API --------------------------------------------------------------
# Your key stays on the server. It is never sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current models: `deepseek-flash` (recommended) or `deepseek-v4-pro`.
DEEPSEEK_MODEL=deepseek-flash
# `disabled` gives fast, cheap plans. `enabled` lets the model think first.
DEEPSEEK_THINKING=disabled
# Only used when thinking is enabled: low | high | max
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TIMEOUT_MS=180000
DEEPSEEK_MAX_TOKENS=12000
DEEPSEEK_MAX_RETRIES=2

# Cost tracking (USD per 1M tokens). Defaults are DeepSeek Flash *peak* prices,
# so the estimate errs on the high side. Adjust if your plan differs.
AI_PRICE_INPUT_MISS=0.30
AI_PRICE_INPUT_HIT=0.006
AI_PRICE_OUTPUT=1.20

# AI usage limits -----------------------------------------------------------
# Number of AI generations / adjustments allowed per user per hour.
AI_RATE_LIMIT_PER_HOUR=8
# How long a generated draft is kept for idempotent retries (seconds).
AI_DRAFT_TTL_SECONDS=1800
